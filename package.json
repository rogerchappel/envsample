{
  "name": "envsample",
  "version": "0.1.0",
  "description": "Generate and validate .env.example files from local source references without reading secrets.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "envsample": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "smoke": "npm run build && node dist/bin.js scan fixtures/basic --format text && node dist/bin.js validate fixtures/basic --example .env.example --format json",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "env",
    "security",
    "local-first",
    "agentic-workflows"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "homepage": "https://github.com/rogerchappel/envsample#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/envsample.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/envsample/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
